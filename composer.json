{
    "name": "kb-data-solutions/php-sdk",
    "description": "PHP SDK for the KB Data Solutions Commerce Integration API",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": [
        "kb-data-solutions",
        "sdk",
        "api-client",
        "commerce"
    ],
    "require": {
        "php": "^8.3",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "php-http/discovery": "^1.20"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-strict-rules": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.95",
        "nyholm/psr7": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "KBDataSolutions\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KBDataSolutions\\Sdk\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.3.99"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "lint:fix": "php-cs-fixer fix",
        "validate-composer": "composer validate --strict",
        "quality": [
            "@validate-composer",
            "@test",
            "@analyse",
            "@lint"
        ]
    }
}
