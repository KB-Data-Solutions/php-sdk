# Ignore everything
*

# Allow directory traversal
!*/

# Source
!src/
!src/**

# Tests
!tests/
!tests/**

# Documentation
!docs/
!docs/**

# GitHub configuration
!.github/
!.github/**

# Root files
!/.gitignore
!/.gitattributes
!/.editorconfig

!/composer.json
!/composer.lock

!/version.txt

!/release-please-config.json
!/.release-please-manifest.json

!/README.md
!/CHANGELOG.md
!/LICENSE

!/phpstan.neon
!/phpstan.neon.dist

!/phpunit.xml
!/phpunit.xml.dist

!/.php-cs-fixer.php
!/.php-cs-fixer.dist.php
